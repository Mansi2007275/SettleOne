# Copy to .env.local (local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.
# The deploy script prints these three lines for you after `arc-forge script ... --broadcast`.

# testnet | mainnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# SettleOnce contract address on the network above
NEXT_PUBLIC_SETTLEONCE_ADDRESS=

# Block the contract was deployed at (the ledger scans InvoicePaid logs from here)
NEXT_PUBLIC_SETTLEONCE_START_BLOCK=

# Optional: your own RPC (Alchemy / QuickNode / dRPC). Leave empty to use Arc's public RPC.
NEXT_PUBLIC_ARC_RPC_URL=
