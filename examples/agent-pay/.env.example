# Copy to .env (same folder) and fill in. .env is gitignored; never commit a real key.

# The agent's own wallet: a 0x-prefixed 32-byte private key.
# Use a throwaway testnet wallet holding a few USDC, never a wallet you care about.
PRIVATE_KEY=0x

# testnet | mainnet
NETWORK=testnet

# The SettleOnce deployment to pay through (deployments/<network>.json after deploying).
SETTLEONCE_ADDRESS=0x
